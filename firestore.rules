rules_version = '2';
// قواعد أمان نظام الاستشارات — الإصدار 3.2
// تُنشر من: Firebase Console ← Firestore Database ← Rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc()  { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active()   { return signedIn() && exists(userDoc()) && get(userDoc()).data.active == true; }
    function isAdmin()  { return active() && get(userDoc()).data.role == 'admin'; }
    function locked()   { return exists(/databases/$(database)/documents/security/lock); }

    // بيانات النظام: للمستخدمين المسجّلين فقط
    // (ملف الحسابات القديم يُقرأ مرة واحدة قبل التفعيل للتحقق من كلمة المرور، ثم يُقفل)
    match /app_state/{key} {
      allow read:  if active() || (key == 'profiles_v2' && !locked());
      allow write: if active();
    }
    // أعداد صفحة الدخول فقط — لا أسماء ولا نصوص
    match /public/{id} {
      allow read: if true;
      allow write: if active();
    }
    // ربط اسم المستخدم بالحساب، وعلامة القفل
    match /security/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && !locked()) || (id == 'lock' && active());
      allow update: if isAdmin() || (signedIn() && !locked() && id == 'usernames');
      allow delete: if false;
    }
    match /users/{uid} {
      allow read:   if active() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && !locked());
      allow update: if isAdmin();
      allow delete: if false;
    }
    // النسخ اليومية: يُنشئها أي مستخدم مسجّل، ولا يقرؤها أو يحذفها إلا المدير، ولا تُعدَّل أبداً
    match /backups/{id} {
      allow create: if active();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
