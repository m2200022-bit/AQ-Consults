rules_version = '2';
// قواعد أمان نظام الاستشارات — الإصدار 3.5
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn()  { return request.auth != null; }
    function userDoc()   { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me()        { return get(userDoc()).data; }
    function isUser()    { return signedIn() && exists(userDoc()) && me().active == true; }
    function active()    { return isUser() && me().role in ['admin', 'consultant']; }
    function isAdmin()   { return isUser() && me().role == 'admin'; }
    function isBackup()  { return isUser() && me().role == 'backup'; }
    function locked()    { return exists(/databases/$(database)/documents/security/lock); }

    // بيانات النظام: المدير يكتب كل شيء، والمستشار يكتب فقط ما يحتاجه للإجابة
    // حساب النسخ الخارجي يقرأ فقط ولا يكتب شيئاً
    match /app_state/{key} {
      allow read:  if active() || isBackup() || (key == 'profiles_v2' && !locked());
      allow write: if isAdmin()
                   || (active() && key in ['consultations_v2', 'messages_v2', 'snippets_v1', 'templates_v1']);
    }
    // سجل العمليات: إضافة فقط، باسم صاحب الحساب نفسه — لا تعديل ولا حذف لأحد
    match /audit/{id} {
      allow create: if active()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['ts', 'actor', 'actorRole', 'action', 'device', 'uid']);
      allow read: if isAdmin() || isBackup();
      allow update, delete: if false;
    }
    // أعداد صفحة الدخول فقط — لا أسماء ولا نصوص
    match /public/{id} {
      allow read: if true;
      allow write: if active();
    }
    // بصمات أسماء المستخدمين وعلامة القفل
    match /security/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && !locked()) || (id == 'lock' && active());
      allow update: if isAdmin() || (signedIn() && !locked() && id == 'usernames');
      allow delete: if false;
    }
    match /users/{uid} {
      allow read:   if active() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && !locked());
      allow update: if isAdmin();
      allow delete: if false;
    }
    // النسخ اليومية داخل Firebase: يُنشئها أي مستخدم، ولا يقرؤها أو يحذفها إلا المدير، ولا تُعدَّل
    match /backups/{id} {
      allow create: if active();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // رموز أجهزة الإشعارات: كل مستخدم يسجّل جهازه باسمه ودوره فقط، ولا يقرؤها أحد (تقرؤها الدالة السحابية)
    match /push_tokens/{t} {
      allow create, update: if active()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.role == me().role
                            && request.resource.data.keys().hasOnly(['uid', 'role', 'device', 'ts']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }
    // مفتاح تشفير النسخ الخارجية: للمدير فقط
    match /vault/{id} {
      allow read, write: if isAdmin();
    }
  }
}
